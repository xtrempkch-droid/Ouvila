# Pacotes da variante "media-player" (app de mídia único).
#
# IMPORTANTE — como validar um nome antes de acrescentar:
# NÃO confie em https://packages.debian.org/bookworm/arm64/<pacote>: ele devolve
# HTTP 200 mesmo quando o pacote não existe para a arquitetura (é uma página de
# erro). A fonte da verdade é o índice da arquitetura:
#
#   curl -s http://deb.debian.org/debian/dists/bookworm/main/binary-arm64/Packages.gz \
#     | zcat | grep -c '^Package: <nome>$'
#
# O passo "Preflight da variante" do workflow confere exatamente isso.
#
# Aqui só entram BIBLIOTECAS: o app é o binário ouvila-media (compilado no
# runner a partir de variants/media-player/src). Não há compositor, navegador
# nem player externo para instalar — é isso que faz a variante ser um binário só.

# Decodificação de áudio/vídeo (FFmpeg 5.1 do bookworm): libavformat/libavcodec/
# libswresample para mídia e libswscale para escalar o quadro ao tamanho da tela.
libavformat59
libavcodec59
libavutil57
libswresample4
libswscale6

# Saída de vídeo direto no KMS (sem X11/Wayland) e som direto no ALSA.
libdrm2
libasound2

# Texto da UI (FreeType) e fontes.
libfreetype6
libfontconfig1
libpng16-16
zlib1g
fonts-dejavu-core

# Shaping (ligaduras e junção de letras) dos alfabetos que a tela de idioma
# oferece. Sem isto o árabe sai com as letras isoladas e o hindi/bengali com as
# vogais fora de lugar — FreeType sozinho só posiciona um glifo por caractere.
libharfbuzz0b

# Fontes por alfabeto: noto-core traz árabe, devanágari (hindi), bengali e
# latino cirílico/gregos; wqy-zenhei cobre o chinês (o noto-cjk é ~100 MB).
fonts-noto-core
fonts-wqy-zenhei

# Rádio e utilitários que os recursos já compartilhados usam.
wpasupplicant
iw
wireless-tools
rfkill
bluez
busybox

# Tela de boot (Plymouth). So o pacote principal: ele ja traz o plugin
# "script" (/usr/lib/<triple>/plymouth/script.so) e o renderizador DRM, que e o
# que o tema do Ouvila usa. "plymouth-themes" so tem temas de exemplo
# (tribar/text/details) e nao e necessario. Sem initramfs tambem funciona: a
# unit plymouth-start vem em sysinit.target.wants do pacote.
plymouth
