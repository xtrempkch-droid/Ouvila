[Unit]
Description=Walkmam Media Player (app unico: DRM/KMS + FFmpeg + ALSA) no tty1
# O app abre o DRM e vira dono do tty1: o getty do tty1 precisa estar fora
# (a imagem o mascara) e a sessao de usuario encerrada.
After=systemd-user-sessions.service systemd-udev-settle.service sound.target
Wants=sound.target
Conflicts=getty@tty1.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=root
Environment=HOME=/root
Environment=XDG_RUNTIME_DIR=/run/walkmam-media
RuntimeDirectory=walkmam-media
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/local/bin/start-media-player.sh
# Mesmo critério do kodi/retroarch: poucas tentativas e para, para o motivo
# ficar visível na tela (um Restart=always apagaria a mensagem de erro).
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
