[Unit]
Description=Ouvila Web UI (Wi-Fi/Bluetooth) na porta 8088
After=NetworkManager.service bluetooth.service

[Service]
Type=simple
# busybox httpd: serve estaticos e executa cgi-bin/*.
ExecStart=/bin/busybox httpd -f -p 0.0.0.0:8088 -h /usr/local/share/ouvila-webui
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
