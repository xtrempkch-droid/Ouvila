[Unit]
Description=Kodi Media Center (Weston/Wayland)
# Ordem com a tela de boot: o Plymouth segura o DRM até plymouth-quit (que roda
# em multi-user). Sem esta linha os dois podem subir juntos e disputar o
# conector — o sintoma seria tela preta. After= em unit ausente é inofensivo.
After=systemd-user-sessions.service systemd-udev-settle.service sound.target plymouth-quit.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=root
Environment=HOME=/root
Environment=KODI_AE_SINK=ALSA
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/local/bin/start-kodi-wayland.sh
# on-failure com RestartSec alto: em falha, tenta poucas vezes e para, deixando
# o motivo visível na tela (evita o loop rápido que apagava a mensagem).
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
