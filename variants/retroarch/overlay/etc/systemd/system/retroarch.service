[Unit]
Description=RetroArch (Weston/Wayland) no tty1
# Ordem com a tela de boot: o Plymouth segura o DRM até plymouth-quit (que roda
# em multi-user). Sem esta linha os dois podem subir juntos e disputar o
# conector — o sintoma seria tela preta. After= em unit ausente é inofensivo.
After=systemd-user-sessions.service systemd-udev-settle.service sound.target plymouth-quit.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=root
Environment=HOME=/root
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/local/bin/start-retroarch.sh
# Igual ao kodi.service: em falha tenta poucas vezes e para, deixando o motivo
# visível na tela (evita o loop rápido que apaga a mensagem).
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
